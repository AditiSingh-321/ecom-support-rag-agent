# ========================================================
# Ecommerce Support Agentic RAG - Environment Configuration
# ========================================================

# --- Flask Server ---
FLASK_SECRET_KEY=dev-secret-key-change-in-prod
JWT_SECRET_KEY=super-secret-jwt-key
FLASK_DEBUG=true
PORT=5000

# --- Vector Store Configuration ---
# Options: "in_memory" (default for local zero-cloud setup) or "pinecone"
VECTOR_STORE_TYPE=in_memory
PINECONE_INDEX_NAME=ecommerce-agentic-rag
PINECONE_API_KEY=your_pinecone_api_key_here

# --- LLM & Embeddings Providers ---
# OpenAI is used for text-embedding-3-large and HyDE hypothetical document generation
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek is used for generation, reasoning, and tool calling
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Enable mock LLM mode if you want to test locally without external LLM API keys
USE_MOCK_LLM=false

# --- External APIs ---
FAKESTORE_API_BASE=https://fakestoreapi.com

# --- Database & Redis (Optional for local mock mode) ---
DATABASE_URL=sqlite:///ecommerce_dev.db
REDIS_URL=redis://localhost:6379/0

# --- Rasa Dialogue (Optional) ---
RASA_ENDPOINT=http://localhost:5005/webhooks/rest/webhook
RASA_ACTIONS_URL=http://localhost:5055/webhook

# --- Streamlit Frontend ---
FLASK_API_BASE_URL=http://localhost:5000/api
